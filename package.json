{
  "name": "electron-video-player",
  "version": "2.0.0",
  "description": "Electron + C++ Native Addon 视频播放器 (FFmpeg + OpenGL)",
  "main": "app/main.js",
  "scripts": {
    "build": "npm run build:css && node scripts/build_native.js",
    "rebuild": "rm -rf build/Release && npm run build",
    "start": "electron .",
    "postinstall": "npm run verify:deploy && npm run build:css && electron-rebuild -o better-sqlite3",
    "build:css": "tailwindcss -c app/tailwind.config.js -i app/chat/input.css -o app/chat/dist/output.css --minify",
    "watch:css": "tailwindcss -c app/tailwind.config.js -i app/chat/input.css -o app/chat/dist/output.css --watch",
    "prestart": "npm run verify:deploy && npm run build:css",
    "verify:deploy": "node scripts/verify_deploy.js"
  },
  "dependencies": {
    "@electron/remote": "^2.1.0",
    "@langchain/core": "^1.1.33",
    "@langchain/langgraph": "^1.2.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/openai": "^1.3.0",
    "@simonwep/pickr": "^1.9.1",
    "better-sqlite3": "^12.8.0",
    "langchain": "^1.2.35",
    "marked": "^9.1.6",
    "node-addon-api": "^7.0.0",
    "node-api-headers": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "cmake-js": "^7.2.1",
    "electron": "^28.3.3",
    "electron-rebuild": "^3.2.9",
    "tailwindcss": "^3.4.19"
  },
  "keywords": [
    "electron",
    "video-player",
    "ffmpeg",
    "opengl",
    "native-addon",
    "cpp"
  ],
  "author": "",
  "license": "MIT"
}
